# Copy to .env and fill in. .env is git-ignored.
# People and their aircraft are configured in config/billionaires.csv.

# API keys
x-rapidapi-key=your-rapidapi-key
openweather_api_key=your-openweather-key
google_maps_api_key=your-google-maps-key     # Maps JavaScript API (browser map only)

# Postgres (database "billiontracker", user "postgres"). No quotes: Kafka Connect reads this file too.
post_gres_password=your-postgres-password

# X (Twitter) API — optional. Pay-per-use; polling stops for the day once X_BUDGET_USD is spent.
x_bearer_token=your-x-bearer-token
X_BUDGET_USD=1.00               # per day, resets at local midnight

# Producer
POLL_SECONDS=3600               # positions + weather every hour
X_BLOCK_HOURS=24                # one top X post per person per day, picked at midnight

# Local services (defaults shown)
KAFKA_BOOTSTRAP=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Public site (scripts/start-public.sh)
READ_ONLY=true                   # visitors can't add/remove aircraft; set false only for local admin use
ADMIN_TOKEN=                     # optional: allows changes from your terminal with "Authorization: Bearer <token>"
web_db_password=                 # generated by scripts/setup-web-db-user.sh (read-only Postgres user)
RATE_LIMIT_PER_MINUTE=120
MAX_WEBSOCKETS_PER_IP=4
MAX_WEBSOCKETS_TOTAL=200

# History (api/history.py)
HISTORY_DAYS=30
HISTORY_START_DATE=2026-10-19        # nothing earlier is shown
